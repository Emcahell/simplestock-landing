---
import WifiSlash from 'phosphor-astro/WifiSlash.astro';
import Lock from 'phosphor-astro/Lock.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import DeviceMobile from 'phosphor-astro/DeviceMobile.astro';
import Check from 'phosphor-astro/Check.astro';
import SectionHeading from './SectionHeading.astro';

const guarantees = [
  'Funciona sin conexión a internet',
  'Sin cuentas, correo ni teléfono',
  'Sin servidores ni nube',
  'Sin anuncios ni rastreadores',
  'Tus datos solo viven en tu teléfono',
  'Código abierto y auditable',
];

const badges = [
  { icon: WifiSlash, label: 'Offline' },
  { icon: Lock, label: 'Sin cuentas' },
  { icon: ShieldCheck, label: 'Sin servidores' },
  { icon: DeviceMobile, label: 'Datos locales' },
];
---
<section id="privacidad" class="scroll-mt-20 px-5 py-20 md:px-8 md:py-28">
  <div class="container-page grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="reveal-init">
      <div class="flex flex-col items-start">
        <SectionHeading align="start">
          <Fragment slot="title">Tu información se queda<br class="hidden sm:block" /> en tu <span class="text-primary">teléfono</span>.</Fragment>
          <Fragment slot="subtitle">Simplestock guarda todo en el almacenamiento privado de tu dispositivo. No hay servidores, ni cuentas, ni analíticas: nadie más puede ver tu negocio, ni siquiera nosotros.</Fragment>
        </SectionHeading>
        <div class="mt-6 flex flex-wrap gap-2">
          {badges.map(({ icon: Icon, label }) => (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border-subtle bg-surface-card px-3 py-1.5 text-xs font-medium text-muted">
              <span class="text-primary"><Icon class="h-[15px] w-[15px]" /></span>
              {label}
            </span>
          ))}
        </div>
        <ul class="mt-8 grid w-full grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
          {guarantees.map(item => (
            <li class="flex items-start gap-2.5 text-sm text-muted">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-success-container text-success">
                <Check class="h-3.5 w-3.5" />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="reveal-init" style="transition-delay:160ms">
      <div class="relative mx-auto w-full max-w-[460px]">
        <div class="absolute inset-0 -z-10 rounded-[2.5rem] bg-primary/15 blur-3xl"></div>
        <img src="/images/screen-4.png" alt="Pantalla de Simplestock mostrando resúmenes" width={1448} height={1086} loading="lazy" decoding="async" class="h-auto w-full rounded-3xl border border-border-subtle bg-surface-card object-cover shadow-2xl shadow-black/20" />
      </div>
    </div>
  </div>
</section>
