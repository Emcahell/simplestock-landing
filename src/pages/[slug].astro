---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";

export async function getStaticPaths() {
  const slugs: Record<string, string> = {
    "politica-de-privacidad": "privacidad",
    "terminos-y-condiciones": "terminos",
    "almacenamiento-y-datos": "datos",
    permisos: "permisos",
    "licencia-y-codigo-abierto": "licencia",
    "descargo-de-responsabilidad": "responsabilidad",
    "preguntas-frecuentes": "preguntas-frecuentes",
  };

  const entries = await getCollection("legal");
  return entries
    .filter((entry) => slugs[entry.id])
    .map((entry) => ({
      params: { slug: slugs[entry.id] },
      props: { entry },
    }));
}

const { entry } = Astro.props;

const { Content, headings } = await render(entry);

const title =
  headings.find((h) => h.depth === 1)?.text?.replace(/\s+—.*$/, "") ??
  "Información legal";

void site;
---

<Layout title={title} description={`${title} de Simplestock.`}>
  <article class="px-5 pb-24 pt-28 md:px-8 md:pt-36">
    <div class="container-page max-w-3xl">
      <a
        href="/"
        class="mb-8 inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-fg"
      >
        <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path
            d="M221.66 133.66l-72 72a8 8 0 0 1-11.32-11.32L196.69 136H40a8 8 0 0 1 0-16h156.69l-58.35-58.34a8 8 0 0 1 11.32-11.32l72 72a8 8 0 0 1 0 11.32Z"
            transform="rotate(180 128 128)"
          ></path>
        </svg>
        Volver al inicio
      </a>

      <div class="legal-content">
        <Content />
      </div>

      <div
        class="mt-12 rounded-2xl border border-border-subtle bg-surface-low p-6 text-sm text-muted"
      >
        <p>
          ¿Tienes dudas sobre este documento? Escríbenos a
          <a href={`mailto:${site.contactEmail}`} class="text-primary hover:underline">
            {site.contactEmail}
          </a>
          o abre un
          <a
            href={site.issues}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:underline">issue en GitHub</a
          >.
        </p>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .legal-content {
    color: var(--ss-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .legal-content h1 {
    color: var(--ss-fg);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
    margin: 0 0 1rem;
  }

  .legal-content h2 {
    color: var(--ss-fg);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 2.25rem 0 0.75rem;
  }

  .legal-content h3 {
    color: var(--ss-fg);
    font-size: 1.05rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }

  .legal-content p {
    margin: 0 0 1rem;
  }

  .legal-content strong {
    color: var(--ss-fg);
    font-weight: 600;
  }

  .legal-content a {
    color: var(--ss-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-content ul,
  .legal-content ol {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .legal-content ul {
    list-style: disc;
  }

  .legal-content ol {
    list-style: decimal;
  }

  .legal-content li {
    margin: 0.35rem 0;
  }

  .legal-content blockquote {
    border-left: 3px solid var(--ss-primary);
    background: var(--ss-surface-secondary);
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 0.75rem 1rem;
    margin: 1.25rem 0;
    color: var(--ss-muted);
  }

  .legal-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--ss-surface-secondary);
    border: 1px solid var(--ss-border);
    border-radius: 0.375rem;
    padding: 0.1rem 0.35rem;
    color: var(--ss-fg);
  }

  .legal-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }

  .legal-content th,
  .legal-content td {
    border: 1px solid var(--ss-border);
    padding: 0.6rem 0.8rem;
    text-align: left;
    vertical-align: top;
  }

  .legal-content th {
    background: var(--ss-surface-secondary);
    color: var(--ss-fg);
    font-weight: 600;
  }

  .legal-content hr {
    border: 0;
    border-top: 1px solid var(--ss-border);
    margin: 2rem 0;
  }
</style>
