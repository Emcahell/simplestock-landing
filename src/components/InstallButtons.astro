---
import AndroidLogo from 'phosphor-astro/AndroidLogo.astro';
import clsx from 'clsx';
import { site } from '../lib/site';

const { class: className = '', size = 'lg', note = false } = Astro.props;

const pad = size === 'lg' ? 'h-[3.25rem] px-5' : 'h-11 px-4';
const storeClass = clsx(
  'group inline-flex items-center gap-3 rounded-xl border border-border-subtle bg-surface-card text-left transition-all duration-200 hover:border-primary/50 hover:bg-surface-secondary',
  pad,
);
---
<div class={clsx('flex flex-col items-start gap-3', className)}>
  <a
    href={site.androidApk}
    download
    rel="noopener noreferrer"
    class={storeClass}
    aria-label="Descargar Simplestock para Android"
  >
    <AndroidLogo class="h-[22px] w-[22px] shrink-0 text-fg" />
    <span class="flex flex-col leading-none">
      <span class="text-[10px] uppercase tracking-wide text-faint">Descargar</span>
      <span class="mt-0.5 text-sm font-semibold text-fg">Android (APK)</span>
    </span>
  </a>
  {
    note && (
      <p class="text-xs leading-relaxed text-muted">
        ¿Usas iPhone? La versión para iOS llegará pronto.
      </p>
    )
  }
</div>
